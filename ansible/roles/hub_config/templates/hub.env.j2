# {{ ansible_managed }}
# The Hub's secrets, from the Key Vault. Change them there and run the playbook again; changes here are overwritten.
{% for variable, secret in hub_env_secrets.items() if secret in hub_config_secrets %}
{% set value = hub_config_secrets[secret] | b64encode if variable in hub_env_base64 else hub_config_secrets[secret] %}
{{ variable }}="{{ value | replace('\\', '\\\\') | replace('"', '\\"') }}"
{% endfor %}
