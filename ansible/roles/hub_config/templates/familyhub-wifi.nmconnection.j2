# {{ ansible_managed }}
# The home Wi-Fi, from the Key Vault. Change it there and run the playbook again; changes here are overwritten.
# NetworkManager prefers the network cable when both are connected, and uses this when the cable is out.
{% macro keyfile(value) %}{{ value | replace('\\', '\\\\') | regex_replace('^ ', '\\\\s') }}{% endmacro %}
[connection]
id=familyhub-wifi
uuid={{ 'familyhub-wifi' | to_uuid }}
type=wifi
autoconnect=true

[wifi]
mode=infrastructure
ssid={{ keyfile(hub_config_secrets[hub_wifi_ssid_secret]) }}

[wifi-security]
key-mgmt=wpa-psk
psk={{ keyfile(hub_config_secrets[hub_wifi_password_secret]) }}

[ipv4]
method=auto

[ipv6]
method=auto
