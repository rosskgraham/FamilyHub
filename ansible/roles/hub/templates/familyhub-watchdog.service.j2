# {{ ansible_managed }}
[Unit]
Description=Restart FamilyHub if it stops answering

[Service]
Type=oneshot
ExecStart=/usr/local/lib/familyhub/watchdog.sh
Environment=FAMILYHUB_HEALTH_URL=http://127.0.0.1:{{ hub_port }}/api/health
RuntimeDirectory=familyhub-watchdog
RuntimeDirectoryPreserve=yes

NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
